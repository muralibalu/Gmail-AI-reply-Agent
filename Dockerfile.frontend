# ── Stage 1: Build the React app ─────────────────────────────────────────────
# We use a multi-stage build. Stage 1 builds the React app (needs Node.js).
# Stage 2 serves it with Nginx (lightweight web server, no Node needed).
# Result: final image is tiny — no Node.js, no node_modules, just static files.
FROM node:20-slim AS builder

WORKDIR /app

# Copy package files first — same caching trick as backend.
# npm install only re-runs if package.json or package-lock.json changed.
COPY package.json package-lock.json* ./
RUN npm install

# Copy source code and build
COPY . .
RUN npm run build
# Output: /app/dist/ — static HTML, CSS, JS files ready to serve


# ── Stage 2: Serve with Nginx ─────────────────────────────────────────────────
# Nginx is a fast, production-grade web server — perfect for serving static files.
# We copy ONLY the built files from Stage 1. Node.js is left behind entirely.
FROM nginx:alpine

# Copy built React files into Nginx's default serve directory
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy our custom Nginx config (handles React Router + API proxy)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Nginx starts automatically — no CMD needed (it's in the base image)
